{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  "rebaseWhen": "never",

  // Renovate is the only dependency bot for this repo. .github/dependabot.yml
  // was removed: it could only update GitHub Actions, which Renovate already
  // handles, and it had no way to reach the pinned tool versions inside
  // build_files/build.sh.
  "customManagers": [
    {
      // Matches a `# renovate: datasource=... depName=...` comment sitting
      // directly above a FOO_VERSION="v1.2.3" assignment in the build script.
      "customType": "regex",
      "managerFilePatterns": ["/^build_files/build\\.sh$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*[A-Z0-9_]+_VERSION=\"(?<currentValue>[^\"]+)\"",
      ],
    },
    {
      // Same idea for upstreams that publish no releases, where the only thing
      // to pin is a commit. Matches a `# renovate: ... branch=<name>` comment
      // above a FOO_COMMIT="<40-hex-sha>" assignment; Renovate tracks the named
      // branch and opens a PR when its SHA moves.
      "customType": "regex",
      "managerFilePatterns": ["/^build_files/build\\.sh$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>\\S+)\\s+branch=(?<currentValue>\\S+)\\s*\\n\\s*[A-Z0-9_]+_COMMIT=\"(?<currentDigest>[0-9a-f]{40})\"",
      ],
    },
    {
      // The rpm-ostree rechunker image in the Justfile. It is pinned as
      // `<repo>:<tag>@sha256:<digest>`: the tag says which stream to follow and
      // the digest is what actually gets pulled, so Renovate only has to move
      // the digest. Kept out of the build.sh managers above because it lives in
      // a different file and is a container, not a release tarball.
      "customType": "regex",
      "managerFilePatterns": ["/^Justfile$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*[A-Z0-9_]+_IMAGE=\"[^\":]+:(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[0-9a-f]{64})\"",
      ],
    },
  ],

  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest"]
    },
    {
      // These tools are pulled straight from GitHub releases with no lockfile
      // behind them, so every bump changes what actually ships in the image.
      // Keep those PRs separate and never auto-merged.
      "matchFileNames": ["build_files/build.sh"],
      "automerge": false,
      "separateMinorPatch": true,
    },
    {
      "enabled": false,
      "matchUpdateTypes": ["digest", "pinDigest", "pin"],
      "matchDepTypes": ["container"],
      "matchFileNames": [".github/workflows/**.yaml", ".github/workflows/**.yml"],
    },
    {
      // The base image is a floating tag on purpose - see the long note above
      // the FROM line in the Containerfile. config:best-practices would
      // otherwise pin it to a digest, and a pinned digest nobody bumps is
      // precisely how Bluefin's own Fedora base got stuck on a 2026-08-07
      // snapshot for a month and left this image a kernel behind. Leave it
      // floating so a daily silverblue-main rebuild lands with no bot in the
      // loop. Major bumps (44 -> 45) are unaffected and still open a PR.
      "enabled": false,
      "matchUpdateTypes": ["digest", "pinDigest", "pin"],
      "matchFileNames": ["Containerfile"],
    },
  ]
}
